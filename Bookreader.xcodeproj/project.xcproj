{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "es",
    "supported": [
      "Base",
      "en",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/skywalkerswartz/kokoro-ios-multilingual.git",
      "version": {
        "revision": "802f904617231cdb746c3910a21d95f16ba022f1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/mlalma/MLXUtilsLibrary.git",
      "version": {
        "version": "0.0.6",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/scinfu/SwiftSoup.git",
      "version": {
        "version": "2.8.8",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/weichsel/ZIPFoundation.git",
      "version": {
        "version": "0.9.20",
      },
    }, {
      "kind": "local",
      "path": "Vendor/mlx-swift",
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "Bookreader",
      "children": [
        { "path": "Assets.xcassets", "target-membership": [ "Bookreader/resources" ] },
        { "path": "Info.plist" },
        { "path": "InfoPlist.xcstrings", "target-membership": [ "Bookreader/resources" ] },
        { "path": "Localizable.xcstrings", "target-membership": [ "Bookreader/resources" ] },
        {
          "kind": "group",
          "path": "App",
          "children": [
            { "path": "AppCoordinator.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "BookreaderApp.swift", "target-membership": [ "Bookreader/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Models",
          "children": [
            { "path": "Book.swift", "target-membership": [ "Bookreader/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Resources",
          "children": [
            { "path": "Bienvenida.txt", "target-membership": [ "Bookreader/resources" ] },
            { "path": "kokoro-v1_0.safetensors", "target-membership": [ "Bookreader/resources" ] },
            { "path": "voices.npz", "target-membership": [ "Bookreader/resources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Services",
          "children": [
            { "path": "DocumentImporter.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "KokoroService.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "LibraryStore.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "PreparedAudioStore.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "BackgroundGenerationLease.swift", "target-membership": [ "Bookreader/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "ViewModels",
          "children": [
            { "path": "LibraryViewModel.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "ReaderViewModel.swift", "target-membership": [ "Bookreader/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Views",
          "children": [
            { "path": "LibraryView.swift", "target-membership": [ "Bookreader/compile-sources" ] },
            { "path": "ReaderView.swift", "target-membership": [ "Bookreader/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "BookreaderTests",
      "children": [
        { "path": "DocumentImporterTests.swift", "target-membership": [ "BookreaderTests/compile-sources" ] },
        {
          "kind": "group",
          "path": "Fixtures",
          "children": [
            { "path": "drm.epub", "target-membership": [ "BookreaderTests/resources" ] },
            { "path": "chapters.pdf", "target-membership": [ "BookreaderTests/resources" ] },
            { "path": "ordered.epub", "target-membership": [ "BookreaderTests/resources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "BookreaderUITests",
      "children": [
        { "path": "ReaderUITests.swift", "target-membership": [ "BookreaderUITests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Bookreader.app", "id": "7D588C281BEEC1DDCCA78241", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/BookreaderTests.xctest", "id": "621962AC7244F5A532AC0C3F", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/BookreaderUITests.xctest", "id": "1DD5A38002724CF8D7DD6314", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Bookreader",
      "id": "6F97B86AFBA71C5B4C5CDB54",
      "product": "Products/Bookreader.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "R8B3FUVAHY",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "MLXUtilsLibrary",
          "product-name": "MLXUtilsLibrary",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SwiftSoup",
          "product-name": "SwiftSoup",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ZIPFoundation",
          "product-name": "ZIPFoundation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "kokoro-ios-multilingual",
          "product-name": "KokoroSwift",
          "build-phase": { "build-phase": "copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
        }, {
          "package": "kokoro-ios-multilingual",
          "product-name": "KokoroSwift",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "mlx-swift",
          "product-name": "MLX",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "$(BOOKREADER_GPU_ENTITLEMENTS)",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "INFOPLIST_FILE": "Bookreader/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.javierpeigneux.Bookreader",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "BookreaderTests",
      "id": "07E455D6F664704988E04436",
      "product": "Products/BookreaderTests.xctest",
      "product-type": "bundle.unit-test",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "R8B3FUVAHY",
      "dependencies": [
        "Bookreader",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.javierpeigneux.BookreaderTests",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Bookreader.app/Bookreader",
      },
    }, {
      "name": "BookreaderUITests",
      "id": "065C7C8D9049B3D1D0ABE175",
      "product": "Products/BookreaderUITests.xctest",
      "product-type": "bundle.ui-testing",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "R8B3FUVAHY",
      "test-host-target": "Bookreader",
      "dependencies": [
        "Bookreader",
      ],
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.javierpeigneux.BookreaderUITests",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "Bookreader",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "1",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "R8B3FUVAHY",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "GENERATE_INFOPLIST_FILE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
    "MARKETING_VERSION": "0.1.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "5.0",
    "TARGETED_DEVICE_FAMILY": "1,2",
  },
  "last-upgrade": "14.3",
}
